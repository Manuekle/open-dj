# Copy to .env (cp .env.example .env) to change any of these. Every one has a default.

# Port on this machine for the app: http://localhost:3000
# PORT=3000

# Public address of this instance, used for absolute social-card (Open Graph) URLs. Defaults to http://localhost:PORT.
# SITE_URL=https://shift.example.com

# Where projects and their tracks are backed up (the app's /data).
# DATA_PATH=./data

# The local model for AI transitions. qwen2.5:3b is quick on a CPU; qwen2.5:7b plans better and needs about 6 GB of
# Docker memory. Changing it here makes docker compose up pull the new one.
# OLLAMA_MODEL=qwen2.5:3b

# Ollama in compose by default. On a Mac, an Ollama installed on the host uses the GPU and is several times faster:
# OLLAMA_URL=http://host.docker.internal:11434
# Without Docker (npm run dev), the app looks for Ollama at http://127.0.0.1:11434.
